# Template of services/api/.env. This file is in git: never write a real password or connection string here.
# Copy it to .env (which git ignores) and fill in the values there.

# Which database the API uses: postgresql (a local server) or render (the PostgreSQL of Render).
# Both have the same structure, built from the .sql files in database/postgresql.
DATABASE_PROVIDER=postgresql

# Local PostgreSQL. Use the project's own role and database, not the postgres superuser:
#   postgresql://real_telemetry:<password>@localhost:5432/real_telemetry
POSTGRESQL_URL=postgresql://real_telemetry:CHANGE_ME@localhost:5432/real_telemetry

# Render: the database's Connect menu. Paste it as it is.
#   On Render itself (the backend service), the Internal Database URL:  postgresql://<user>:<password>@dpg-<id>-a/<database>
#   From a laptop, the External Database URL, which needs SSL (the API turns it on by itself):
#   postgresql://<user>:<password>@dpg-<id>-a.<region>-postgres.render.com/<database>
RENDER_DATABASE_URL=

# Which server this is: moon or earth. Same code, two deployments, each with its own database.
# The moon works on its own and, when asked (POST /api/sync), sends its data to earth and downloads earth's.
NODE_ROLE=moon

# Moon only: the base URL of the earth server
EARTH_URL=http://localhost:8001

# Shared secret between the two servers, the same on both. Long and random, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Without it, syncing is off.
SYNC_TOKEN=

# To run the earth server on the same machine, put its settings in .env.earth (also ignored by git) and start it
# with ENV_FILE=.env.earth

# false (the default) lets anyone open the app with no PIN, for the public demo. Signing in still works.
# true makes every endpoint ask for a signed-in user
AUTH_REQUIRED=false

# The voice of the emergency guide (ElevenLabs). The key needs the Text to Speech and ElevenAgents permissions.
# The agent id is printed by apps/web/scripts/create-emergency-agent.mjs. Without both, the guide plays its
# recorded audio and the voice agent is off.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
