# Copy to .env (not in git). Never commit a real password or connection string.

# Which database the API uses: postgresql (the local one in Docker) or supabase.
# Both have the same structure, built from the .sql files in database/postgresql.
DATABASE_PROVIDER=postgresql

# Local PostgreSQL from database/postgresql/docker-compose.yml. Same password as database/postgresql/.env.
POSTGRESQL_URL=postgresql://postgres:CHANGE_ME@localhost:5432/real_telemetry

# Supabase: Project Settings > Database > Connection string. Paste it as it is.
# The session pooler (port 5432) or the transaction pooler (port 6543) both work.
SUPABASE_DATABASE_URL=
